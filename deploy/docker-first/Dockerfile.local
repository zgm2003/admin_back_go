FROM python:3.12-slim AS runtime

WORKDIR /app

COPY deploy/docker-first/.docker-bin/admin-api /app/admin-api
COPY deploy/docker-first/.docker-bin/admin-worker /app/admin-worker

RUN mkdir -p /app/runtime/logs /app/runtime/payment/certs/alipay /app/exports && \
    chmod +x /app/admin-api /app/admin-worker

ENV APP_ENV=local
ENV HTTP_ADDR=:8080
ENV TZ=Asia/Shanghai

EXPOSE 8080

CMD ["/app/admin-api"]
