# Docker-first backend runtime env template.
# Local validation: copy to ./admin-go.env.
# Production/Baota: copy to /www/docker/admin-go-backend/admin-go.env when following the root runbook.
# Do not commit real secrets.

APP_ENV=production
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s

LOG_DIR=/app/runtime/logs

# MySQL/Redis can be local to the same server or placed on a separate state node.
# Important: this file is read inside backend containers. 127.0.0.1 means the backend container itself, not the host.
# Production/Baota: use private-network IP/DNS for the state node.
# Docker Desktop local validation: host services can use host.docker.internal:3307 / host.docker.internal:6380.
# Public IP must be protected by firewall allowlist.
MYSQL_DSN=admin_user:CHANGE_ME@tcp(DB_PRIVATE_IP:3306)/admin?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=1h

REDIS_ADDR=REDIS_PRIVATE_IP:6379
REDIS_PASSWORD=
REDIS_DB=0

# Must stay stable across all admin-api/admin-worker containers.
# Code derives JWT signing, refresh-token pepper, secretbox, and session-cache keys internally.
APP_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARS
TOKEN_REDIS_DB=2

# Payment business certs follow backend runtime nodes, not the MySQL/Redis state node.
# Mount host /www/docker/admin-go-backend/runtime to container /app/runtime on every backend node.
# Cert files are stored under /app/runtime/payment/certs/alipay/<config_code>/<sha256>.crt.
PAYMENT_CERT_BASE_DIR=/app

# Email code uses Tencent SES plus mail_configs.verify_code_ttl_minutes.
# Phone login code is fixed to 123456 and does not send Tencent SMS yet; its Redis TTL still comes from sms_configs.verify_code_ttl_minutes.

QUEUE_ENABLED=true
QUEUE_REDIS_DB=3
QUEUE_CONCURRENCY=10

REALTIME_ENABLED=true
REALTIME_PUBLISHER=redis

# Keep scheduler enabled on only one worker cluster owner.
SCHEDULER_ENABLED=true

# Browser origins allowed to call the API and open WebSocket connections.
CORS_ALLOW_ORIGINS=https://zgm2003.cn
